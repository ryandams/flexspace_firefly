{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug firefly-app (nrf54lm20dk, cortex-debug, J-Link over USB)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/ncsworkspace/builds/build/firefly-app/zephyr/zephyr.elf",
            "servertype": "jlink",
            "device": "nRF54LM20A_M33",
            "interface": "swd",
            "gdbPath": "/opt/ncs/toolchain/opt/zephyr-sdk/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
            "runToEntryPoint": "main"
        },
        {
            "name": "Debug firefly-app (nrf93m1dk, cortex-debug, J-Link over USB)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/ncsworkspace/builds/build/firefly-app/zephyr/zephyr.elf",
            "servertype": "jlink",
            "device": "nRF54L15_M33",
            "interface": "swd",
            "gdbPath": "/opt/ncs/toolchain/opt/zephyr-sdk/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
            "runToEntryPoint": "main"
        },
        {
            // F5 builds the app for native_sim (./3_build.sh sim) and runs it
            // on the host under gdb - no board needed. It stops at the app's
            // main(); the native simulator has a main() of its own, hence the
            // full path.
            "name": "Debug firefly-app (native_sim, no board)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build native_sim",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "program": "${workspaceFolder}/ncsworkspace/builds/build_sim/firefly-app/zephyr/zephyr.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "-break-insert -f ${workspaceFolder}/ncsworkspace/firefly-app/code/main.c:main" }
            ]
        }
    ]
}
